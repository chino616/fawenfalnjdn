# Local runtime/build caches; project results and reference data remain tracked.
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.pytest-tmp/
**/.ipynb_checkpoints/
**/build/
**/*.egg-info/
Gitup01/outputs/**/build-temp/
Gitup01/outputs/refactor/original/
Gitup01/outputs/refactor_r4/original/

# Local refactor validation/build outputs are not included in this branch commit.
Gitup01/outputs/refactor/
Gitup01/outputs/refactor_r4/

# Refactor-02 local artifacts remain external.
Gitup01/outputs/experiment_modularization/
Gitup01/backup/

# Refactor-07 curated publication: keep only the output boundary README.
Gitup01/outputs/**
!Gitup01/outputs/README.md
Gitup01/backup/
Gitup01/archives/
# Curated formal data are tracked; Gitup01/.gitignore keeps explicitly
# local-only reference reproductions outside the publication.
Gitup01/data/**/*.png
Gitup01/**/*.ipynb
Gitup01/docs/**/*.pdf
Gitup01/docs/**/*.zip

# Local CONUS archival and isolated publication workspaces.
CONUS-Backup/
.github-publish/
