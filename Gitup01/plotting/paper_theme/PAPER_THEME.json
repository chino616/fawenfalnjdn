    },
    {
      "key": "forest",
      "label": "Fern",
      "color": "#568B60",
      "bar_fill": "#9AC8A7",
      "linestyle": ":",
      "marker": "p",
      "hatch": "xx"
    }
  ],
  "series_scaling": {
    "canonical_count": 12,
    "assignment": "Map each physics object/dataset to a stable palette index and reuse that index in every figure; never reassign by plotting order.",
    "line_strategy": "For indices >= 12 reuse the base color with a different linestyle and marker; 12 unique colors are not claimed perceptually separable under all conditions.",
    "linestyle_cycle": [
      "-",
      "--",
      "-.",
      ":"
    ],
    "marker_cycle": [
      "o",
      "s",
      "^",
      "D",
      "v",
      "P",
      "X",
      "h",
      ">",
      "<",
      "*",
      "p"
    ],
    "hatch_cycle": [
      "",
      "//",
      "xx",
      "..",
      "\\\\",
      "++",
      "oo",
      "||",
      "--",
      "OO",
      "//",
      "xx"
    ],
    "markers_required_when_series_gt": 6,
    "hatches_recommended_when_bars_gt": 6,
    "facet_recommended_when_series_gt": 8,
    "legend_restructure_threshold": 6,
    "colors_are_not_the_only_encoding": true
  }
}
